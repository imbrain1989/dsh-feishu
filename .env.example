# ============================================================
# 飞书连接配置(两种模式)
#
# 模式一:自定义机器人 Webhook(单向推送,群内添加机器人)
# 模式二:企业自建应用(推荐,功能全:任意群/用户发消息、读写数据、事件订阅)
# 两种模式可同时配置,CLI 用 --app 切换
# ============================================================

# ---------- 模式一:Webhook ----------
# 飞书群 -> 设置 -> 群机器人 -> 添加机器人 -> 自定义机器人
FEISHU_WEBHOOK_URL=
# 安全设置中的"加签"密钥(可选)
FEISHU_WEBHOOK_SECRET=

# ---------- 模式二:企业自建应用 ----------
# https://open.feishu.cn 开发者后台 -> 凭证与基础信息
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 目标群 chat_id(形如 oc_xxxxxxxx;群设置 -> 群信息 或通过 API 查询);文本/卡片/图片消息的目标群
FEISHU_CHAT_ID=

# 图片传输复用上述 FEISHU_APP_ID / FEISHU_APP_SECRET / FEISHU_CHAT_ID,无需新增项
# 需开通权限:im:image(或 im:message)并发布应用版本

# ---------- 接收消息(长连接机器人) ----------
# 回复模式:echo=原样回显 | dsh=交给本机 DSH 智能体(推荐)
FEISHU_BOT_MODE=dsh
# dsh 模式配置:可执行文件路径(留空用 PATH 里的 dsh;Windows 建议填 JS 入口完整路径)
FEISHU_DSH_CMD=
FEISHU_DSH_TIMEOUT_MS=180000

# ---------- 回执策略(不再每条都回「收到」) ----------
# 收到消息先不回任何东西;只有任务超过阈值仍未跑完,才回一条「还在处理中」提示。
# 超时阈值(毫秒,缺省 150000 = 150s;设 0 恢复"收到即回执"的旧行为)
FEISHU_STATUS_THRESHOLD_MS=150000
# 重复提醒间隔(毫秒,缺省 0 = 只提醒一次);长任务想每隔一段时间报平安就填,如 120000
FEISHU_STATUS_INTERVAL_MS=0
# false = 完全静默(任何情况都不发提示)
FEISHU_STATUS_ENABLED=true
# 可选:自定义提示文案,{seconds} 会被替换成已耗时秒数
FEISHU_STATUS_MESSAGE=

# ---------- 接收图片(用户发图给机器人) ----------
# 接收图片需在开发者后台开通「获取与上传图片或文件资源」im:resource 并重新发布版本,
# 否则下载会 403 / code=99991672(错误会打进日志,不会静默失败)。
# 图片落盘目录(缺省 <工作区>/.feishu-images);dsh 模式会把路径交给智能体用 read_image 读
FEISHU_IMAGE_DIR=
# 单张图片体积上限(字节,缺省 20971520 = 20MB);超过则跳过该张并记日志
FEISHU_IMAGE_MAX_BYTES=

# ---------- DSH 审批(飞书端) ----------
# dsh 模式默认开启:智能体需要审批时,机器人会把请求发到群里,群成员回复
# 「同意/拒绝」即可放行/拒绝该次高权限操作(同对话框内任何成员均可审批)。
# 审批等待上限(秒),缺省 100;建议小于 FEISHU_DSH_TIMEOUT_MS
FEISHU_APPROVAL_TIMEOUT_MS=100

# ---------- 定时股价播报(随 npm run listen 一起运行) ----------
FEISHU_STOCK_ENABLED=true
FEISHU_STOCK_CODE=002432        # 九安医疗;可改任意 A 股代码
FEISHU_STOCK_TIMES=09:35,10:30,11:30,13:00,14:00,15:00
FEISHU_STOCK_CHAT_ID=           # 默认用 FEISHU_CHAT_ID;可单独指定群
